+// mul_mat_f with ids: column j uses its occ-th slot that lists expert_idx (a token may list an expert in several slots).
+// Returns whether this warp found one; sets more if a column of this warp has a further matching slot.
+template <int cols_per_block, int nwarps>
+static __device__ __forceinline__ int mul_mat_f_map_slots(
+        const int32_t * __restrict__ ids, int * slot_map, const int occ, int & more, const int expert_idx, const int col_base,
+        const int ncols_dst_total, const int nchannels_dst, const int stride_col_id, const int stride_row_id) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    int found = 0;
+
+    for (int j0 = 0; j0 < cols_per_block; j0 += nwarps) {
+        const int j = j0 + threadIdx.y;
+
+        if (threadIdx.x == 0) {
+            slot_map[j] = -1;
+        }
+        ggml_cuda_syncwarp();
+
+        if (col_base + j >= ncols_dst_total) {
+            continue;
+        }
+
+        const int32_t * __restrict__ id_row = ids + j*stride_row_id;
+
+        int seen = 0; // matching slots in the earlier chunks of the row
+        for (int k0 = 0; k0 < nchannels_dst; k0 += warp_size) {
+            const int k     = k0 + threadIdx.x;
+            const int match = k < nchannels_dst && id_row[k*stride_col_id] == expert_idx;
+            const int rank  = warp_prefix_inclusive_sum<int, warp_size>(match);
+
+            if (match && seen + rank - 1 == occ) {
+                slot_map[j] = k;
+                found = 1;
+            }
+            seen += __shfl_sync(0xFFFFFFFF, rank, warp_size - 1, warp_size);
+        }
+        more |= seen > occ + 1;
+    }
+    return found;
+}
