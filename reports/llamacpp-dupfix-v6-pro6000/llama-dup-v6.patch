+// A tile of mul_mat_f whose tokens list its expert in several slots (repeated expert ids): one pass per occurrence.
+// Out of line so that it does not add to the kernel's register use.
+template <typename tile_A, typename tile_B, typename tile_C, typename T, int rows_per_block, int cols_per_block, int nwarps>
+static __device__ __noinline__ void mul_mat_f_tile_occurrences(
+        const T * __restrict__ x, const float * __restrict__ y, const int32_t * __restrict__ ids, float * __restrict__ dst,
+        int * slot_map, char * compute_base, const int expert_idx, const int col_base, const int row0,
+        const int ncols, const int ncols_dst_total, const int nchannels_dst, const int stride_row, const int stride_col_y, const int stride_col_dst,
+        const int stride_col_id, const int stride_row_id, const int stride_channel_y, const int stride_channel_dst) {
+    for (int occ = 0; ; ++occ) {
+        if (occ > 0) {
+            __syncthreads(); // the previous pass is done with slot_map and the shared tiles
+            int more = 0;
+            const int found = mul_mat_f_map_slots<cols_per_block, nwarps>(
+                ids, slot_map, occ, more, expert_idx, col_base, ncols_dst_total, nchannels_dst, stride_col_id, stride_row_id);
+            if (!__syncthreads_or(found)) {
+                return;
+            }
+        }
+        mul_mat_f_tile<tile_A, tile_B, tile_C, T, rows_per_block, cols_per_block, nwarps, true>(
+            x, y, dst, slot_map, compute_base, col_base, row0,
+            ncols, ncols_dst_total, stride_row, stride_col_y, stride_col_dst, stride_channel_y, stride_channel_dst);
+    }
+}
