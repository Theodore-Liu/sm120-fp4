+// MUL_MAT_ID: whether an expert has more entries than the ncols_channel columns one channel covers (repeated expert ids).
+static __device__ __forceinline__ bool mmq_moe_any_overflow(
+        const int32_t * __restrict__ expert_bounds, const int n_experts, const int ncols_channel) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    int overflow = 0;
+#pragma unroll 4
+    for (int e = threadIdx.x; e < n_experts; e += warp_size) {
+        overflow |= expert_bounds[e + 1] - expert_bounds[e] > ncols_channel;
+    }
+    return warp_reduce_any<warp_size>(overflow);
+}
+
+// MUL_MAT_ID: the columns [col_low, col_high) of channel zt. Channels from n_experts on hold the further columns of experts
+// with more entries than the ncols_channel columns one channel covers (repeated expert ids); zt becomes that expert.
+static __device__ __forceinline__ void mmq_moe_cols(
+        const int32_t * __restrict__ expert_bounds, const int n_experts, const int ncols_channel, int & zt, int & col_low, int & col_high) {
+    if (zt < n_experts) {
+        col_low  = expert_bounds[zt + 0];
+        col_high = expert_bounds[zt + 1];
+        return;
+    }
+    // Warp-parallel: lane e of each group of warp_size experts takes expert e0 + e.
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    int extra = zt - n_experts;
+    col_low  = 0;
+    col_high = 0;
+    for (int e0 = 0; e0 < n_experts; e0 += warp_size) {
+        const int e     = e0 + threadIdx.x;
+        const int low   = e < n_experts ? expert_bounds[e + 0] : 0;
+        const int ncols = e < n_experts ? expert_bounds[e + 1] - low : 0;
+        const int n_extra_e = ncols > 0 ? (ncols - 1) / ncols_channel : 0;
+        const int incl      = warp_prefix_inclusive_sum<int, warp_size>(n_extra_e);
+
+        // The lane whose extra channels include this one, if any:
+        int lane = extra >= incl - n_extra_e && extra < incl ? int(threadIdx.x) : -1;
+#pragma unroll
+        for (int offset = warp_size/2; offset > 0; offset >>= 1) {
+            lane = max(lane, __shfl_xor_sync(0xFFFFFFFF, lane, offset, warp_size));
+        }
+        if (lane >= 0) {
+            const int extra_e = __shfl_sync(0xFFFFFFFF, extra - (incl - n_extra_e), lane, warp_size);
+            zt       = e0 + lane;
+            col_low  = __shfl_sync(0xFFFFFFFF, low, lane, warp_size) + (extra_e + 1)*ncols_channel;
+            col_high = min(__shfl_sync(0xFFFFFFFF, low + ncols, lane, warp_size), col_low + ncols_channel);
+            return;
+        }
+        extra -= __shfl_sync(0xFFFFFFFF, incl, warp_size - 1, warp_size);
+    }
