+// MUL_MAT_ID: whether an expert has more entries than the ncols_channel columns one channel covers (repeated expert ids).
+static __device__ __forceinline__ bool mmq_moe_any_overflow(
+        const int32_t * __restrict__ expert_bounds, const int n_experts, const int ncols_channel) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    int overflow = 0;
+#pragma unroll 4
+    for (int e = threadIdx.x; e < n_experts; e += warp_size) {
+        overflow |= expert_bounds[e + 1] - expert_bounds[e] > ncols_channel;
+    }
+    return warp_reduce_any<warp_size>(overflow);
+}
+
+// MUL_MAT_ID overflow launch: with repeated expert ids an expert can have more entries than the ncols_channel columns one
+// channel covers. Fills moe_table with (expert, first column, end column) for each of the nchannels_extra overflow channels
+// (all zero when unused) and returns whether any expert overflows. One warp computes it, lane e taking experts e, e + warp_size, ...
+static __device__ __forceinline__ bool mmq_moe_build_table(
+        const int32_t * __restrict__ expert_bounds, const int n_experts, const int ncols_channel,
+        int32_t * moe_table, const int nchannels_extra) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    int n_before = 0; // overflow channels of the experts in earlier groups
+    for (int e0 = 0; e0 < n_experts; e0 += warp_size) {
+        const int e     = e0 + threadIdx.x;
+        const int low   = e < n_experts ? expert_bounds[e + 0] : 0;
+        const int ncols = e < n_experts ? expert_bounds[e + 1] - low : 0;
+        const int n_extra_e = ncols > 0 ? (ncols - 1) / ncols_channel : 0;
+        const int incl      = warp_prefix_inclusive_sum<int, warp_size>(n_extra_e);
+        for (int k = 0; k < n_extra_e; ++k) {
+            const int c = n_before + incl - n_extra_e + k;
+            if (c < nchannels_extra) {
+                moe_table[3*c + 0] = e;
+                moe_table[3*c + 1] = low + (k + 1)*ncols_channel;
+                moe_table[3*c + 2] = min(low + ncols, low + (k + 2)*ncols_channel);
