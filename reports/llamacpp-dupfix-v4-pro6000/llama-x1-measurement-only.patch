+    const int n_extra = ntx_need - ntx_grid;
+    const int n_work  = int(nsamples_y.z*nchannels_y.z)*nty*n_extra;
+    for (int w = work_begin; w < n_work; w += work_stride) {
+        const int jt = ntx_grid + w % n_extra;
+        int tmp = w / n_extra;
+        const int zt = tmp % int(nchannels_y.z);
+        tmp /= int(nchannels_y.z);
+        const int wt = tmp % int(nsamples_y.z);
+        const int it = tmp / int(nsamples_y.z);
